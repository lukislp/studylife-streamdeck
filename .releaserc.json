{
  "repositoryUrl": "git@github.com:lukislp/studylife-streamdeck.git",
  "branches": [
    "main"
  ],
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/npm",
      {
        "npmPublish": false
      }
    ],
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "node scripts/set-manifest-version.mjs ${nextRelease.version}"
      }
    ],
    "@semantic-release/github"
  ]
}
