{
    "repositoryUrl":  "git@github.com:lukislp/studylife-streamdeck.git",
    "branches":  [
                     "main"
                 ],
    "plugins":  [
                    "@semantic-release/commit-analyzer",
                    "@semantic-release/release-notes-generator",
                    {
                        "value":  [
                                      "@semantic-release/npm",
                                      {
                                          "npmPublish":  false
                                      }
                                  ],
                        "Count":  2
                    },
                    {
                        "value":  [
                                      "@semantic-release/exec",
                                      {
                                          "prepareCmd":  "node scripts/set-manifest-version.mjs ${nextRelease.version}"
                                      }
                                  ],
                        "Count":  2
                    },
                    "@semantic-release/github"
                ]
}
