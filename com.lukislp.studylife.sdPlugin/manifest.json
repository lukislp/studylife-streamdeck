{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "Name": "StudyLife",
  "Version": "1.3.3.0",
  "Author": "lukislp",
  "Description": "Control your StudyLife focus timer and see study status from physical Stream Deck keys.",
  "Icon": "imgs/plugin-icon",
  "CategoryIcon": "imgs/category-icon",
  "Category": "StudyLife",
  "CodePath": "bin/plugin.js",
  "PropertyInspectorPath": "ui/property-inspector.html",
  "UUID": "com.lukislp.studylife",
  "SDKVersion": 2,
  "Software": {
    "MinimumVersion": "6.4"
  },
  "OS": [
    {
      "Platform": "mac",
      "MinimumVersion": "10.15"
    },
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    }
  ],
  "Nodejs": {
    "Version": "20"
  },
  "Actions": [
    {
      "Name": "Focus Timer",
      "UUID": "com.lukislp.studylife.timer",
      "Icon": "imgs/actions/timer/icon",
      "Tooltip": "Tap to start/pause/resume the shared StudyLife focus timer; hold to stop it.",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/actions/timer/key",
          "TitleAlignment": "middle",
          "FontSize": 13
        }
      ]
    },
    {
      "Name": "Study Status",
      "UUID": "com.lukislp.studylife.status",
      "Icon": "imgs/actions/status/icon",
      "Tooltip": "Shows this week's and today's study hours plus your streak; press to refresh immediately.",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/actions/status/key",
          "TitleAlignment": "middle",
          "FontSize": 13
        }
      ]
    },
    {
      "Name": "Course Goal",
      "UUID": "com.lukislp.studylife.coursegoal",
      "Icon": "imgs/actions/coursegoal/icon",
      "Tooltip": "Shows one open course goal's countdown; pick the course in this key's Property Inspector.",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/actions/coursegoal/key",
          "TitleAlignment": "middle",
          "FontSize": 13
        }
      ]
    },
    {
      "Name": "Quick Note",
      "UUID": "com.lukislp.studylife.quicknote",
      "Icon": "imgs/actions/quicknote/icon",
      "Tooltip": "Saves a preset note (written once in the Property Inspector) with one press, optionally tagged with a course.",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/actions/quicknote/key",
          "TitleAlignment": "middle",
          "FontSize": 13
        }
      ]
    },
    {
      "Name": "Switch Course",
      "UUID": "com.lukislp.studylife.switchcourse",
      "Icon": "imgs/actions/switchcourse/icon",
      "Tooltip": "Cycles the plugin-wide current course used by Focus Timer and Quick Note keys with no course of their own.",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/actions/switchcourse/key",
          "TitleAlignment": "middle",
          "FontSize": 13
        }
      ]
    },
    {
      "Name": "Focus Mode",
      "UUID": "com.lukislp.studylife.focusmode",
      "Icon": "imgs/actions/focusmode/icon",
      "Tooltip": "Cycles the built-in focus preset applied to your next session. On Stream Deck + the dial scrubs presets live; push to apply.",
      "Controllers": [
        "Keypad",
        "Encoder"
      ],
      "Encoder": {
        "layout": "$X1",
        "TriggerDescription": {
          "Rotate": "Scrub the focus preset",
          "Push": "Apply the scrubbed preset"
        }
      },
      "States": [
        {
          "Image": "imgs/actions/focusmode/key",
          "TitleAlignment": "middle",
          "FontSize": 13
        }
      ]
    }
  ]
}
